# Amazing Box (scale -1.5) alternated with a power-2 sine bulb.
# MB3D falls back to the numerical gradient DE for this mix
# (DE options 11 + 0 combine to 0).
width = 640
height = 480
iterations = 30
zoom = 0.35
z_start = -8
rotation = 25, -35, 0
smooth_normals = 2
color_start = 59
color_end = 64

[formula]
name = Amazing Box
scale = -1.5
min_r = 0.5
fold = 1
iterations = 2

[formula]
name = Integer Power
power = 2
iterations = 1
